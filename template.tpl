- name: '[User Data] Email, phone number, id, click_id and partner_user_id are sent
    to Spotify exactly as provided, with no hashing applied by this tag'
  code: |-
    // Spotify's own pixel script hashes email/phone_number itself, unconditionally,
    // with no detection of an already-hashed value — so this tag must never hash
    // them itself (whether the input looks raw or already-hashed), or the value
    // would get hashed twice and stop matching Spotify's records. "id", "click_id"
    // and "partner_user_id" are never touched by Spotify's script either, so they
    // also pass through as-is.
    const alreadyHashedLookingEmail = 'b4c9a289323b21a01c3e940f150eb9b8c542587f1abfd8f0e1cc1ffc5e475514';

    const testData = assign(assign({}, mockData), {
      enableAdvancedMatching: true,
      userDataList: [
        { name: 'email', value: alreadyHashedLookingEmail },
        { name: 'phone_number', value: '+1 (415) 555-2671' },
        { name: 'id', value: 'raw-internal-id' },
        { name: 'click_id', value: 'CLICK123' },
        { name: 'partner_user_id', value: 'PARTNER456' }
      ]
    });

    runCode(testData);

    const aliasCall = queueCalls.filter((c) => c[0] === 'alias');
    assertThat(aliasCall[0][1].email).isEqualTo(alreadyHashedLookingEmail);
    assertThat(aliasCall[0][1].phone_number).isEqualTo('+1 (415) 555-2671');
    assertThat(aliasCall[0][1].id).isEqualTo('raw-internal-id');
    assertThat(aliasCall[0][1].click_id).isEqualTo('CLICK123');
    assertThat(aliasCall[0][1].partner_user_id).isEqualTo('PARTNER456');
