    assertApi('gtmOnSuccess').wasCalled();
- name: '[Event Parameters] DataLayer auto-map adds no per-item product fields for
    non-checkout/purchase events'
  code: |-
    // Spotify's schema has no line_items array for product/addtocart/etc — those
    // events only have a single product_id/product_name/... slot, so silently
    // picking one GA4 item out of several and dropping the rest would misrepresent
    // the event. No item fields are auto-mapped for these events at all (quantity
    // is still summed, since it's a real top-level field on its own).
    const testData = assign(assign({}, mockData), {
      eventNameStandard: 'addtocart',
      enableDataLayerMapping: true
    });

    mock('copyFromDataLayer', (key) => {
      if (key === 'items') return [
        { item_id: 'SKU1', item_name: 'Product 1', item_category: 'Shoes', item_brand: 'Acme', item_variant: 'Red', item_variant_id: 'V1', price: 10, quantity: 2 },
        { item_id: 'SKU2', item_name: 'Product 2' }
      ];
      return undefined;
    });

    runCode(testData);

    const eventCall = queueCalls.filter((c) => c[0] !== 'conf' && c[0] !== 'alias');
    const params = eventCall[0][1];
    assertThat(params.quantity).isEqualTo(3);
    assertThat(params.product_id).isUndefined();
    assertThat(params.product_name).isUndefined();
    assertThat(params.product_type).isUndefined();
    assertThat(params.product_vendor).isUndefined();
    assertThat(params.variant_name).isUndefined();
    assertThat(params.variant_id).isUndefined();
    assertThat(params.line_items).isUndefined();

    assertApi('gtmOnSuccess').wasCalled();
