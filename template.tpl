    assertThat(params.line_items.length).isEqualTo(2);
    assertThat(params.line_items[0].product_id).isEqualTo('SKU1');
    assertThat(params.line_items[0].product_name).isEqualTo('Product 1');
    assertThat(params.line_items[0].product_type).isEqualTo('Shoes');
    assertThat(params.line_items[0].product_vendor).isEqualTo('Acme');
    assertThat(params.line_items[0].variant_name).isEqualTo('Red');
    assertThat(params.line_items[0].variant_id).isEqualTo('V1');
    assertThat(params.line_items[0].value).isEqualTo(10);
    assertThat(params.line_items[0].quantity).isEqualTo(2);
    assertThat(params.line_items[1].product_id).isEqualTo('SKU2');
