scenarios:
- name: '[Happy Path] Fires conf, alias and event commands in order and injects SDK'
  code: |-
    const testData = assign(assign({}, mockData), {
      enableAdvancedMatching: true,
      userDataList: [{ name: 'email', value: 'user@example.com' }]
    });

    runCode(testData);

    assertThat(queueCalls.length).isEqualTo(3);
    assertThat(queueCalls[0][0]).isEqualTo('conf');
    assertThat(queueCalls[0][1].key).isEqualTo('PIXEL_KEY_123');
    assertThat(queueCalls[1][0]).isEqualTo('alias');
    assertThat(queueCalls[1][1].email).isEqualTo('user@example.com');
    assertThat(queueCalls[2][0]).isEqualTo('view');

    assertThat(injectScriptCalls.length).isEqualTo(1);
    assertThat(injectScriptCalls[0].url).isEqualTo('https://pixel.byspotify.com/ping.min.js');
    assertThat(injectScriptCalls[0].cacheToken).isEqualTo('spotifyPixel');

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: '[Config] Missing or empty pixelKey calls gtmOnFailure'
  code: |-
    ['', '   ', undefined].forEach((value) => {
      queueCalls = [];
      injectScriptCalls = [];

      const testData = assign(assign({}, mockData), { pixelKey: value });
      runCode(testData);

      assertThat(queueCalls.length).isEqualTo(0);
      assertThat(injectScriptCalls.length).isEqualTo(0);
      assertApi('gtmOnFailure').wasCalled();
    });
- name: '[Consent] Manual consent denied values call gtmOnSuccess without sending'
  code: |-
    [false, 'false', 0, '0', 'denied'].forEach((value) => {
      queueCalls = [];
      injectScriptCalls = [];

      const testData = assign(assign({}, mockData), { consentGranted: value });
      runCode(testData);

      assertThat(queueCalls.length).isEqualTo(0);
      assertThat(injectScriptCalls.length).isEqualTo(0);
      assertApi('gtmOnSuccess').wasCalled();
      assertApi('gtmOnFailure').wasNotCalled();
    });
- name: '[Consent] GCM consent denied queues callbacks and calls gtmOnSuccess without
    SDK'
  code: |-
    const testData = assign(assign({}, mockData), { enableGoogleConsentMode: true });
    mock('isConsentGranted', () => false);

    runCode(testData);

    assertThat(queueCalls.length).isEqualTo(0);
    assertThat(injectScriptCalls.length).isEqualTo(0);
    assertApi('addConsentListener').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
